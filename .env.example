# ==============================================================================
# Silogtran Liquidaciones API - Variables de Entorno
# ==============================================================================
# Copie este archivo a .env en desarrollo local.
# En Render, configure estas variables directamente en el panel de Environment.
# NUNCA suba contraseñas, tokens reales o secretos al repositorio.

# Configuración de URLs y credenciales de Silogtran
SILOGTRAN_BASE_URL=https://construproyec.colombiasoftware.net
SILOGTRAN_LOGIN_URL=https://construproyec.colombiasoftware.net/index.php?page=Login
SILOGTRAN_REPORT_URL=https://construproyec.colombiasoftware.net/index.php?page=Despacho.Liquidacionmanifiesto.InformeGeneral_111
SILOGTRAN_USERNAME=
SILOGTRAN_PASSWORD=

# Centro de costo obligatorio a seleccionar tras el login (Default: CONSTRUPROYEC-PRINCIPAL)
SILOGTRAN_COST_CENTER=CONSTRUPROYEC-PRINCIPAL

# Token permanente de la API para consumidor único (si no usa tabla multi-consumidor)
# Generado con `openssl rand -hex 32` o similar
API_TOKEN=

# Clave maestra para administrar tokens de consumidores (Endpoints: /api/v1/admin/tokens)
ADMIN_API_KEY=

# Archivo de persistencia para tokens multi-consumidor (o ruta local)
TOKEN_STORAGE_PATH=tokens.json

# Configuración de Caché y Límites (Optimizado para 512 MB RAM en Render)
CACHE_TTL_SECONDS=900
MAX_CACHE_ENTRIES=500
MAX_DATE_RANGE_DAYS=31
REQUEST_TIMEOUT_SECONDS=60
SILOGTRAN_SESSION_LIFETIME_SECONDS=900

# Rate Limiting (Solicitudes por minuto por token/IP)
RATE_LIMIT_PER_MINUTE=60

# Observabilidad y Servidor
LOG_LEVEL=INFO
PORT=8000
CORS_ORIGINS=["*"]
